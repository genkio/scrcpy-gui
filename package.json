{
	"name": "scrcpy-gui",
	"version": "2.5.0",
	"author": "SimonMa <simon@tomotoes.com>",
	"homepage": "https://github.com/genkio/scrcpy-gui",
	"description": "✨ A simple & beautiful GUI application for scrcpy",
	"license": "Apache-2.0",
	"main": "./out/main/index.js",
	"engines": {
		"node": ">=20.19"
	},
	"bin": {
		"scrcpy-gui": "./bin/scrcpy-gui"
	},
	"scripts": {
		"start": "electron-vite dev",
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"app": "./bin/scrcpy-gui",
		"pack:mac": "electron-vite build && electron-builder --mac --dir",
		"dist:mac": "electron-vite build && electron-builder --mac",
		"dist:mac:all": "electron-vite build && electron-builder --mac --arm64 --x64",
		"dist:win": "electron-vite build && electron-builder --win",
		"dist:linux": "electron-vite build && electron-builder --linux",
		"fetch:server": "./scripts/build-scrcpy-server.sh"
	},
	"dependencies": {
		"@element-plus/icons-vue": "^2.3.2",
		"@yume-chan/adb": "^2.6.0",
		"@yume-chan/adb-scrcpy": "^2.3.2",
		"@yume-chan/adb-server-node-tcp": "^2.5.2",
		"@yume-chan/scrcpy": "^2.3.0",
		"@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
		"@yume-chan/stream-extra": "^2.6.1",
		"element-plus": "^2.14.3",
		"vue": "^3.5.40",
		"vue-i18n": "^11.4.7"
	},
	"devDependencies": {
		"@swmansion/argent": "^0.17.0",
		"@vitejs/plugin-vue": "^6.0.8",
		"electron": "^43.2.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"sass": "^1.102.0",
		"vite": "^7.3.6"
	}
}
