#!/usr/bin/env bash
# Launch Scrcpy GUI straight from this checkout - no install into /Applications.
# Symlink it anywhere on your PATH: ln -s "$PWD/bin/scrcpy-gui" ~/.local/bin/scrcpy-gui
set -euo pipefail

source_path=${BASH_SOURCE[0]}
while [ -L "$source_path" ]; do
	link_dir=$(cd -P "$(dirname "$source_path")" && pwd)
	source_path=$(readlink "$source_path")
	[[ $source_path != /* ]] && source_path=$link_dir/$source_path
done
root=$(cd -P "$(dirname "$source_path")/.." && pwd)

cd "$root"

if [ ! -d node_modules ]; then
	echo "scrcpy-gui: installing dependencies..." >&2
	npm install
fi

stale=0
if [ ! -f out/main/index.js ]; then
	stale=1
elif [ -n "$(find src electron.vite.config.mjs package.json -newer out/main/index.js -print -quit 2>/dev/null)" ]; then
	stale=1
fi

if [ "$stale" -eq 1 ]; then
	echo "scrcpy-gui: building..." >&2
	npm run build >/dev/null
fi

exec ./node_modules/.bin/electron . "$@"
